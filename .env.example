# Copia este archivo a `.env` y rellena los valores. `.env` NO se versiona.

# Carpetas de datos (relativas a la raíz del proyecto)
RUTA_DATOS_RAW=data/raw
RUTA_DATOS_PROCESSED=data/processed

# Ritmo de las peticiones a fuentes públicas (segundos entre peticiones).
# Sé respetuoso con CENDOJ/BOE: no satures sus servidores.
EXTRACCION_DELAY_SEGUNDOS=1.5

# User-Agent identificativo para las peticiones de scraping.
EXTRACCION_USER_AGENT=ChavalesLegales-TeamUCM/0.1 (proyecto educativo UCM)
