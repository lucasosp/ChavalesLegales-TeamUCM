# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Datos (no versionar descargas ni resultados pesados) ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.pdf
*.csv
*.jsonl

# --- Entorno / secretos ---
.env
.env.*
!.env.example

# --- Editores / SO ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# Entregables: versionar PDFs/HTML del dossier (excepción a *.pdf)
!entregables/
!entregables/*.pdf
!entregables/*.html
